# Local tool downloads; version/checksum instructions remain tracked
/tools/*.jar

# OS/editor temporary files
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Keep plans, instructions, lockfiles, circuits, fixtures and reports tracked.

# Checksum-pinned downloaded runtimes and archives (never commit binaries)
/tools/node/
/tools/java/
/tools/cache/
